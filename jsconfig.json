{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler"
  },
  "files": [
    "types/frontend-globals.d.ts",
    "types/control-panel-api.d.ts"
  ],
  "include": [
    "src/js/**/*.js",
    "src/entries/**/*.js",
    "src/control-panel/**/*.js",
    "catalog-snapshot.js"
  ]
}
