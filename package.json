{
  "name": "site-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Static furniture catalog site and deterministic build tools",
  "scripts": {
    "setup": "npm run setup:python && npm run setup:browsers",
    "setup:python": "node tools/run_project_python.js --system tools/setup_python_env.py",
    "setup:esbuild:offline": "node tools/run_project_python.js --system tools/bootstrap_esbuild_offline.py",
    "check:esbuild:offline": "node tools/run_project_python.js --system tools/bootstrap_esbuild_offline.py --check",
    "setup:browsers": "playwright install chromium",
    "setup:browsers:linux": "playwright install --with-deps chromium",
    "build": "npm run build:local",
    "build:frontend": "node tools/run_project_python.js tools/build_frontend_assets.py",
    "build:catalog-data": "node tools/run_project_python.js tools/catalog_compiler.py",
    "check:catalog-data": "node tools/run_project_python.js tools/catalog_compiler.py --check",
    "check:frontend": "node tools/run_project_python.js tools/build_frontend_assets.py --check",
    "build:pages": "node tools/run_project_python.js tools/build_site_pages.py",
    "build:seo:private": "npm run build:local",
    "build:seo:public": "node tools/run_project_python.js tools/build_deploy_bundle.py --out dist/site-public-preview --seo-mode public --confirm-public-indexing --skip-if-current",
    "check:seo-routes": "node tools/run_project_python.js tools/seo_route_lock.py --check",
    "seo:routes:update": "node tools/run_project_python.js tools/seo_route_lock.py --update",
    "verify:seo:public": "node tools/run_project_python.js tools/verify_public_seo.py --out dist/site-public-preview --clean-legacy-artifacts",
    "verify:seo:public:full": "node tools/run_project_python.js tools/verify_public_seo.py --out dist/site-public-preview --force-audit --clean-legacy-artifacts",
    "verify:seo:public:rebuild": "node tools/run_project_python.js tools/verify_public_seo.py --out dist/site-public-preview --force-rebuild --clean-legacy-artifacts",
    "verify:seo:live": "node tools/run_project_python.js tools/audit_public_seo.py --live",
    "check:pages": "node tools/run_project_python.js tools/build_site_pages.py --check",
    "build:big-pages-viewer": "node tools/run_project_python.js tools/build_big_pages_viewer.py",
    "check:big-pages-viewer": "node tools/run_project_python.js tools/build_big_pages_viewer.py --check",
    "build:deploy": "node tools/run_project_python.js tools/build_deploy_bundle.py --out dist/site-upload-r2 --seo-mode private --skip-if-current --mirror-to dist/site-local --clean-legacy-artifacts",
    "build:deploy:private": "node tools/run_project_python.js tools/build_deploy_bundle.py --out dist/site-upload-r2 --seo-mode private --skip-if-current --mirror-to dist/site-local --clean-legacy-artifacts",
    "build:deploy:public": "node tools/run_project_python.js tools/verify_public_seo.py --out dist/site-public-preview --mirror-to dist/site-upload-r2 --mirror-to dist/site-local --clean-legacy-artifacts",
    "test:js": "node tools/run_project_python.js tools/verify_project.py --javascript-only",
    "pretest:python": "node tools/run_project_python.js --system tools/setup_python_env.py --quiet",
    "test:python": "node tools/run_project_python.js tools/verify_project.py --python-only",
    "pretest:e2e": "node tools/check_playwright_browser.js",
    "test:e2e": "playwright test",
    "pretest:e2e:update": "node tools/check_playwright_browser.js",
    "test:e2e:update": "node tools/update_visual_snapshots.js",
    "pretest": "node tools/run_project_python.js --system tools/setup_python_env.py --quiet",
    "test": "node tools/run_project_python.js tools/verify_project.py --quick",
    "preverify": "node tools/run_project_python.js --system tools/setup_python_env.py --quiet && node tools/check_playwright_browser.js",
    "verify": "node tools/run_project_python.js tools/verify_project.py",
    "verify:r2": "node tools/run_project_python.js tools/verify_remote_catalog_assets.py --base-url https://cdn.bargig-furniture.com --versioned",
    "telemetry:report": "node tools/run_project_python.js tools/telemetry_report.py --open",
    "build:local": "node tools/run_project_python.js tools/build_deploy_bundle.py --out dist/site-upload-r2 --seo-mode private --skip-if-current --mirror-to dist/site-local --clean-legacy-artifacts",
    "dev": "node tools/run_project_python.js tools/serve_site.py",
    "serve": "node tools/run_project_python.js tools/serve_site.py",
    "build:e2e": "node tools/run_project_python.js tools/build_deploy_bundle.py --out dist/site-local --seo-mode private --skip-if-current --clean-legacy-artifacts",
    "dev:check": "node tools/run_project_python.js tools/serve_site.py --ensure-current ask",
    "clean:artifacts": "node tools/run_project_python.js --system tools/clean_project_artifacts.py",
    "check:node-tools": "node tools/check_node_install_scripts.js",
    "postinstall": "node tools/check_node_install_scripts.js",
    "verify:r2:origin": "node tools/run_project_python.js tools/verify_remote_catalog_assets.py --base-url https://cdn.bargig-furniture.com --all-tiers",
    "test:search-performance": "node tests/catalog_search_worker.test.js",
    "check:frontend-contracts": "node tools/run_project_python.js tools/check_frontend_contracts.py",
    "build:control-panel-api-types": "node tools/run_project_python.js tools/generate_control_panel_api_types.py",
    "check:control-panel-api-types": "node tools/run_project_python.js tools/generate_control_panel_api_types.py --check",
    "check:types": "tsc -p jsconfig.json --pretty false",
    "check:runtime-symbols": "node tools/check_frontend_runtime_symbols.js",
    "tasks": "node tools/project_tasks.js",
    "catalogs:sync-pdfs": "node tools/project_tasks.js sync-catalog-pdfs",
    "catalogs:convert": "node tools/project_tasks.js convert-catalogs",
    "catalogs:convert:force": "node tools/project_tasks.js convert-catalogs-force",
    "catalogs:ocr-refresh": "node tools/project_tasks.js refresh-ocr-search",
    "r2:sync:preview": "node tools/project_tasks.js r2-preview",
    "r2:sync": "node tools/project_tasks.js r2-sync",
    "site:bundle:r2": "node tools/project_tasks.js bundle-site-r2",
    "site:deploy:cloudflare": "node tools/project_tasks.js deploy-cloudflare",
    "site:control-panel": "node tools/project_tasks.js control-panel",
    "site:configure-r2-cors": "node tools/project_tasks.js configure-r2-cors"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "esbuild": "0.28.1",
    "typescript": "5.8.3",
    "wrangler": "4.112.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
