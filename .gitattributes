# Keep source and generated text deterministic across Windows and GitHub CI.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Cloudflare control files have no normal extension; keep them deterministic too.
_headers* text eol=lf
# Human-readable generated artifacts are also byte-checked; prevent
# core.autocrlf from rewriting them on Windows checkouts.
catalog-big-pages-viewer-netfree/README.txt text eol=lf
robots.txt text eol=lf
# Platform launchers keep their native line endings in every checkout.
*.sh text eol=lf
*.bat text eol=crlf
