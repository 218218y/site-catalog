{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bargig-furniture.com/schemas/catalogs.config.schema.json",
  "title": "Catalog source configuration",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "pdf"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "subcategory": {
        "type": "string"
      },
      "pdf": {
        "type": "string",
        "pattern": "^assets/pdfs/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.pdf$"
      },
      "ocr": {
        "type": "boolean"
      },
      "sort": {
        "type": "integer"
      },
      "badge": {
        "type": "string"
      }
    }
  }
}
